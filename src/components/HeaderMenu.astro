---

---
<div>
    <!--ハンバーガーメニュー-->
    <div class="md:hidden cursor-pointer">
        <button class="btn-trigger relative w-8 h-6 cursor-pointer transition-all duration-500" type="button">
            <span class="button-bar1 absolute left-0 w-full h-[3px] bg-black rounded-full top-0 transition-all duration-500"></span>
            <span class="button-bar2 absolute left-0 w-full h-[3px] bg-black rounded-full top-[10px] transition-all duration-500"></span>
            <span class="button-bar3 absolute left-0 w-full h-[3px] bg-black rounded-full bottom-0 transition-all duration-500"></span>
        </button>
    </div>

    <!--ナビゲーションメニュー-->
    <nav class="navigation-menu bg-white md:bg-none fixed top-[65px] left-0 z-0 w-full h-lvh transition-all ease-in-out duration-300 translate-x-full md:flex md:items-center md:static md:translate-x-0 md:w-auto md:h-auto">
        <ul class="w-[88.8%] mx-auto md:flex">
            <li class="text-2xl md:mx-4 md:text-base text-black hover:text-gray-600 leading-10">
                <a href="/about/" class="">About</a>
            </li>
            <li class="relative group text-2xl md:mx-4 md:text-base text-black hover:text-gray-600 leading-10">
                <button class="navigation-menu-lesson flex items-center justify-center gap-2 hover:text-gray-600 cursor-pointer transform transition-transform duration-300">
                    Lesson
                    <svg class="md:hidden icon-chevron w-5 h-5 transform transition-transform duration-300"
                         xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <ul class="ml-10 md:hidden lesson-menu max-h-0 opacity-0 overflow-hidden transition-all duration-300 ease-in-out">
                    <li class="text-2xl text-black hover:text-gray-600 leading-10"><a href="/lesson/programs/">Lesson
                        Programs</a></li>
                    <li class="text-2xl text-black hover:text-gray-600 leading-10"><a href="/lesson/beginners/"
                                                                                      class="">初めての方へ</a>
                    </li>
                </ul>
                <ul class="navigation-menu-lesson-child opacity-0 -translate-y-2 invisible md:group-hover:opacity-100 md:group-hover:translate-y-0 group-hover:visible absolute -left-[20px] min-w-48 bg-white pt-2.5 px-5 pb-5 top-2.5 shadow-lg transition-all ease-in-out duration-300">
                    <li class="text-black hover:text-gray-600 leading-10"><a href="/lesson/programs/">Lesson
                        Programs</a></li>
                    <li class="text-black hover:text-gray-600 leading-10"><a href="/lesson/beginners/"
                                                                             class="">初めての方へ</a>
                    </li>
                </ul>
            </li>
            <li class="block text-2xl md:mx-4 md:text-base text-black hover:text-gray-600 leading-10">
                <a href="/faqs/" class="">FAQ</a>
            </li>
            <li class="block text-2xl md:mx-4 md:text-base text-black hover:text-gray-600 leading-10">
                <a href="/contact/" class="">Contact</a>
            </li>
            <li class="block text-2xl md:mx-4 md:text-base text-black hover:text-gray-600 leading-10">
                <a href="https://www.instagram.com/shino_m.studio?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw=="
                   class="">Instagram</a>
            </li>
        </ul>
    </nav>
</div>

<style lang="scss">
  /* ハンバーガーメニューの動き */
  .btn-trigger.active span:nth-of-type(1) {
    transform: translateY(10px) rotate(-45deg);
  }

  .btn-trigger.active span:nth-of-type(2) {
    opacity: 0;
  }

  .btn-trigger.active span:nth-of-type(3) {
    transform: translateY(-11px) rotate(45deg);
  }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btnTrigger = document.querySelector('.btn-trigger');
        const navigationMenu = document.querySelector('.navigation-menu');
        const lessonButton = document.querySelector('.navigation-menu-lesson');
        const lessonMenu = document.querySelector('ul.ml-10.md\\:hidden');
        const iconChevron = document.querySelector('.icon-chevron');

        if (btnTrigger && navigationMenu) {
            btnTrigger.addEventListener('click', function () {
                btnTrigger.classList.toggle('active');
                navigationMenu.classList.toggle('translate-x-full');  // SP表示でメニュー表示切り替え
            });
        }

        if (lessonButton && lessonMenu && iconChevron) {
            lessonButton.addEventListener('click', function () {
                if (lessonMenu.classList.contains('max-h-0')) {
                    lessonMenu.classList.remove('max-h-0', 'opacity-0');
                    lessonMenu.classList.add('max-h-96', 'opacity-100');
                    iconChevron.classList.add('rotate-180');
                } else {
                    lessonMenu.classList.remove('max-h-96', 'opacity-100');
                    lessonMenu.classList.add('max-h-0', 'opacity-0');
                    iconChevron.classList.remove('rotate-180');
                }
            });
        }
    });
</script>




