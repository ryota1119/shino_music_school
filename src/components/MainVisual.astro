---
import {Picture} from 'astro:assets';

interface StaticImage {
    src: string;
    width: number;
    height: number;
    format: string;
}

interface Props {
    src: string;
    width: number;
    height: number;
    pageTitle: string;
}

const {src, width, height, pageTitle} = Astro.props;
---

<div class="relative">
    <div>{src}</div>
    <Picture src={src} alt={pageTitle} width={width} height={height}
             class="mt-[65px] h-[248px] md:h-[480px]"/>
    <h1 class="text-white text-3xl md:text-5xl absolute top-[50%] left-[50%] transform -translate-x-1/2 -translate-y-1/2">{pageTitle}</h1>
</div>
