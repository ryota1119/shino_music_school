---
import Layout from '@layouts/Layout.astro';
import AboutContents from '@layouts/AboutContents.astro';
import AccessMap from "../layouts/AccessMap.astro";
import {Picture} from "astro:assets";
import visualImageSrc from "@visualImages/about.png"

const pageTitle = "About";
---

<Layout title="About | しのはら音楽教室">
    <div class="relative">
        <Picture src={visualImageSrc} alt={pageTitle} width={visualImageSrc.width} height={visualImageSrc.height}
                 class="w-full object-cover mt-[65px] h-[248px] md:h-[480px]"/>
        <h1 class="text-white text-3xl md:text-5xl absolute top-[50%] left-[50%] transform -translate-x-1/2 -translate-y-1/2">{pageTitle}</h1>
    </div>
    <AboutContents/>
</Layout>
