---
import Layout from '@layouts/Layout.astro';
import ContactContents from '@layouts/ContactContents.astro';

const pageTitle = 'Contact';
const description =
  'しのはら音楽教室の講師紹介。福岡市長住で20年以上の指導経験を持つ講師が、一人一人の目標に合わせた丁寧なレッスンを提供。ピアノ、ギター、ドラムの専門講師が在籍。';
---

<Layout title="Contact | しのはら音楽教室" description={description}>
  <div class="relative">
    <img
      src="/images/mainVisuals/about.png"
      alt={pageTitle}
      class="w-full object-cover mt-[65px] h-[248px] md:h-[480px]"
    />
    <h1
      class="text-white text-3xl md:text-5xl absolute top-[50%] left-[50%] transform -translate-x-1/2 -translate-y-1/2"
    >
      {pageTitle}
    </h1>
  </div>
  <ContactContents />
</Layout>
