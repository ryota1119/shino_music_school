---
import Layout from '../../layouts/Layout.astro';
import {Picture} from "astro:assets";
import LessonProgramsContents from "../../layouts/LessonProgramsContents.astro";
import visualImageSrc from "@visualImages/lesson.png"

const pageTitle = "Lesson Programs";
---

<Layout title="Lesson Program | しのはら音楽教室">
    <div class="relative">
        <Picture src={visualImageSrc} alt={pageTitle} width={visualImageSrc.width} height={visualImageSrc.height}
            class="w-full object-cover mt-[65px] h-[248px] md:h-[480px]"/>
        <h1 class="text-white text-3xl md:text-5xl absolute top-[50%] left-[50%] transform -translate-x-1/2 -translate-y-1/2">{pageTitle}</h1>
    </div>
    <LessonProgramsContents/>
</Layout>
